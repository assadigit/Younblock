# Build outputs
/dist/
/build/bin/
frontend/node_modules/
frontend/dist/
frontend/wailsjs/

# Go
*.exe
*.test
*.out
*.prof

# Local runtime data (never commit logs or settings)
*.log
logs/
settings.json
settings.json.bad
sysproxy-backup.json

# OS noise
.DS_Store
Thumbs.db

# Web UI embedded bundle (built, never committed — placeholder.txt only)
internal/webui/dist/*
!internal/webui/dist/placeholder.txt

# flatpak-builder local cache
.flatpak-builder/
core

# The WebView2 bootstrapper the vendored wails embeds into every Windows
# build (go:embed in internal/webview2runtime). The *.exe rule above
# would hide it, so it is un-ignored here — a fresh clone must be able
# to `wails build` for Windows without downloading anything.
!vendor/github.com/wailsapp/wails/v2/internal/webview2runtime/MicrosoftEdgeWebview2Setup.exe

# Android lane (docs/android-port 04 §3). The AAR is a build output —
# regenerated by build-android.sh from source, never committed. The
# Gradle wrapper jar IS committed (fresh clones must build without a
# local Gradle install).
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/libs/

<?xml version="1.0" encoding="utf-8"?>
<!-- Window chrome for the shell: no action bar (the Svelte screen is the
     whole UI), and a dark window background matched to the app's off
     gradient mid-tone (#272730, frontend tokens.css) so there is no white
     flash before the WebView paints. -->
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
    </style>
</resources>

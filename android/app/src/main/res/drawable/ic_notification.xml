<?xml version="1.0" encoding="utf-8"?>
<!-- The notification glyph (D113): the Y mark — the first letter of
     the name, the one symbol that reads as the app at status-bar
     size. Android renders a notification's small icon as an ALPHA
     MASK only: every color is discarded and the system tints the
     surviving shape monochrome, so the old M8-am pill glyph — brand
     red and green drawn on an opaque 108x108 background square —
     flattened to exactly that filled solid square in the bar (the
     pill and its LED were invisible up there). This glyph is
     alpha-only: white round-cap strokes on transparency, the two
     arms meeting at (12, 11.4) and the stem down to (12, 19.2),
     stroke 2.4dp, drawn on the 24dp status-bar grid with
     Material-keyline optical margins so the letter survives every
     vendor's raster size and both bar themes. The launcher icon is
     untouched (the owner's padlock mark, the mipmap set
     scripts/gen_android_icons.py composes); this glyph stays the
     shell's status voice. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M5.4,4.8 L12,11.4 L18.6,4.8 M12,11.4 L12,19.2"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>

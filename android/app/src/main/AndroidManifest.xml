<?xml version="1.0" encoding="utf-8"?>
<!-- Younblock Android shell — the M3 skeleton (docs/android-port 07 §6).
     Permission inventory, honest and minimal:
       INTERNET                            engine sockets (DoH, upstream dials)
       FOREGROUND_SERVICE                  the M5 foreground service keeping the tunnel alive
       FOREGROUND_SERVICE_CONNECTED_DEVICE the FGS type for the VPN service (API 34+ policy)
       POST_NOTIFICATIONS                  runtime permission on 13+; the state notification
       (no location, no storage beyond app-private, no SYSTEM_ALERT_WINDOW,
        no request-install-packages; ACCESS_NETWORK_STATE deliberately NOT
        requested — the Go netmon reads interfaces in-process, verified this
        session, so the permission would be a lie.)
     The <queries> block covers the default allow-list targets (checking
     they exist is what raises the M6 NO_TARGET_APPS surface; M4
     fail-closes when none is installed). The <service> is the M4
     deliverable: YounblockVpnService, the routing path. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.android.chrome" />
        <package android:name="com.google.android.youtube" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The routing path (roadmap M4): foreground, connectedDevice
             type, only the system may bind (BIND_VPN_SERVICE). The
             app itself starts it explicitly from the connect flow. -->
        <service
            android:name=".YounblockVpnService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
